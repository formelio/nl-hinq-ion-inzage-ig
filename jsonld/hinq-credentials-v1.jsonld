{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "id": "@id",
    "type": "@type",
    "schema": "http://schema.org/",
    "hinq": "https://example.hinq.nl/credentials/v1#",

    "HinqUraCredential": {
      "@id": "hinq:HinqUraCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "@propagate": true,

        "id": "@id",
        "type": "@type",

        "organization": {
          "@id": "schema:organization",
          "@context": {
            "@version": 1.1,
            "@protected": true,
            "ura": "hinq:ura"
          }
        }
      }
    },

    "HinqAgbCredential": {
      "@id": "hinq:HinqAgbCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "@propagate": true,

        "id": "@id",
        "type": "@type",

        "organization": {
          "@id": "schema:organization",
          "@context": {
            "@version": 1.1,
            "@protected": true,
            "agb": "hinq:agb"
          }
        }
      }
    },

    "HinqHealthcareProviderRoleTypeCredential": {
      "@id": "hinq:HinqHealthcareProviderRoleTypeCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "@propagate": true,

        "id": "@id",
        "type": "@type",

        "roleCodeNL": "hinq:roleCodeNL"
      }
    },

    "HinqBsnCredential": {
      "@id": "hinq:HinqBsnCredential",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "@propagate": true,

        "id": "@id",
        "type": "@type",

        "bsn": "hinq:bsn"
      }
    }
  }
}
