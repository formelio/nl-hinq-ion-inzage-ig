@startuml
hide footbox
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 5
skinparam maxMessageSize 180

box Data user organization (Rivo-Noord viewer)\n
actor "Healthcare professional" as User
participant "Data user application" as App
participant "Nuts node" as UserNode
end box

box Data holder organization (HINQ ION)\n
participant "Nuts node" as HolderNode
participant "PDP" as PDP
participant "HINQ ION service" as Ion
end box

box Source organization\n
participant "Source system" as Src
end box

User -> App ++ : Log in
App -> App : Create user session\nwith the details for the NutsEmployeeCredential

== Access Token Request ==

User -> App : Open patient
App -> App : Resolve the patient's BSN
App -> UserNode ++ : Request access token\nwith NutsEmployeeCredential and HinqBsnCredential
UserNode <-> HolderNode : Presentation definition and\nVerifiable Presentation
UserNode --> App -- : Access token, bound to this patient

== Patient Search ==

App -> PDP ++ : POST /Patient/_search\nwith the BSN
PDP -> HolderNode ++ : Token introspection
HolderNode --> PDP -- : Claims
PDP -> PDP : Check the access rules\nand the patient's consent
PDP -> Ion ++ : POST /Patient/_search
Ion -> Src ++ : Request the patient
Src --> Ion -- : Patient
Ion --> PDP -- : Bundle with the Patient
PDP --> App -- : Bundle with the Patient\nand its logical id

== Data Request ==

loop For each resource type
  App -> PDP ++ : GET /{resource}?patient={id}
  PDP -> HolderNode ++ : Token introspection
  HolderNode --> PDP -- : Claims
  PDP -> PDP : Check the access rules\nand the patient's consent
  PDP -> Ion ++ : GET /{resource}?patient={id}
  Ion -> Src ++ : Request the data
  Src --> Ion -- : Data
  Ion --> PDP -- : Bundle
  PDP --> App -- : Bundle
end loop

App --> User -- : Display the patient's data

@enduml
